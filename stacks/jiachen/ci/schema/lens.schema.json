        "properties": {
          "severity": {
            "type": "string",
            "description": "One of: P0, P1, P2, P3."
          },
          "type": {
            "type": "string",
            "description": "One of: defect, leftover, maintainability."
          },
          "class": {
            "type": "string",
            "description": "One of: behavior-regression, error-handling, fail-open-violation, retry-semantics, concurrency, lifecycle-resource, persistence-migration, data-loss, contract-break, config-default, compat-rollout, security, permission-auth, injection, parallel-impl-missed, duplicate-implementation, over-engineering, cross-feature-impact, performance, ui-layout, test-gap, observability, other."
          },
          "title": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "line": {
            "type": "integer"
          },
          "symbol": {
            "type": "string"
          },
          "evidence_level": {
            "type": "integer",
            "description": "One of: 1, 2, 3, 4, 5."
          },
          "introduced": {
            "type": "string",
            "description": "One of: this_mr, pre_existing, unknown."
          },
          "suggestion": {
            "type": "string"
          },
          "related_paths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "needs_human": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "title",
          "why",
          "questions",
          "paths"
